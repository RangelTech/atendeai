# Exemplo de ambiente do atendeai. SÓ NOMES: os valores ficam no Infisical (rt-produtos/atendeai, ambiente prod) e chegam à VPS no deploy. Nunca commitar valores.
# Em desenvolvimento local basta copiar para .env e preencher o que for usar; sem SMTP/LLM o app roda em modo de desenvolvimento.

ATENDEAI_ADMIN_KEY=
ATENDEAI_CAKTO_SEGREDO=
ATENDEAI_CANAIS_TOKEN=
ATENDEAI_DEMO_SENHA=
ATENDEAI_IMAGEM_BASE=
ATENDEAI_IMAGEM_KEY=
ATENDEAI_LLM_BASE=
ATENDEAI_LLM_KEY=
ATENDEAI_LLM_MODELO=
ATENDEAI_SEGREDO_SESSAO=
ATENDEAI_SMTP_FROM=
ATENDEAI_VOZ_TOKEN=
SMTP_HOST=
SMTP_PASSWORD=
SMTP_PORT=
SMTP_USER=
